---
import { ArrowUpRight } from '@lucide/astro';
import data from '../data/map.json';

const { grid, max } = data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Sequential ramp that stays inside the site's warm-paper palette.
const stops = [
  [255, 247, 250],
  [251, 228, 236],
  [246, 203, 218],
  [238, 171, 193],
  [228, 133, 165],
  [213, 92, 133],
  [189, 59, 103],
  [143, 37, 73],
];

function colour(t: number) {
  const x = Math.min(Math.max(t, 0), 1) * (stops.length - 1);
  const i = Math.min(Math.floor(x), stops.length - 2);
  const f = x - i;
  const c = stops[i].map((v, k) => Math.round(v + (stops[i + 1][k] - v) * f));
  return `rgb(${c.join(',')})`;
}

const best = grid.map((row) => row.indexOf(Math.max(...row)));
---

<figure class="map-card">
  <div class="map-head">
    <p class="map-title">The hypergamy map</p>
    <a class="map-link" href={`${base}/hypergamy_map.svg`} target="_blank" rel="noreferrer">
      Full annotated map
      <ArrowUpRight size={13} stroke-width={2} aria-hidden="true" />
    </a>
  </div>

  <div
    class="map-plot"
    role="group"
    aria-label="Ten by ten hypergamy map. Rows are men's packages, columns are women's packages, numbered one to ten."
  >
    <div class="col-labels" aria-hidden="true">
      {Array.from({ length: 10 }, (_, j) => <span>{j + 1}</span>)}
    </div>
    <div class="row-labels" aria-hidden="true">
      {Array.from({ length: 10 }, (_, i) => <span>{i + 1}</span>)}
    </div>
    <div class="map-cells">
      {grid.map((row, i) =>
        row.map((p, j) => (
          <button
            type="button"
            class:list={['map-cell', { best: best[i] === j }]}
            style={`--cell:${colour(p / max)}`}
            data-row={i + 1}
            data-col={j + 1}
            data-p={(p * 100).toFixed(1)}
            tabindex={i === 0 && j === 0 ? 0 : -1}
            aria-label={`Man package ${i + 1}, woman package ${j + 1}: ${(p * 100).toFixed(1)} percent chance both say yes${best[i] === j ? ', his highest-mutual package' : ''}`}
          />
        ))
      )}
    </div>
    <p class="axis x" aria-hidden="true">women's package →</p>
  </div>

  <figcaption>
    <output id="map-readout" aria-live="polite">Focus or hover a cell to read its chance of a mutual yes.</output>
    <span class="map-key">
      Rows are men, columns women. Each cell is P(he says yes) × P(she says yes) from the
      committed dyad weights. The dot marks that man's highest-mutual package. The ten rungs
      are packages — looks, age and income climb together — not ten real people.
    </span>
  </figcaption>
</figure>

<script>
  const figure = document.querySelector<HTMLElement>('.map-card');
  if (figure) {
    const out = figure.querySelector<HTMLOutputElement>('output');
    const cells = [...figure.querySelectorAll<HTMLButtonElement>('.map-cell')];

    const show = (cell: HTMLButtonElement) => {
      if (out) {
        out.textContent = `Man package ${cell.dataset.row}, woman package ${cell.dataset.col}: ${cell.dataset.p}% chance both say yes.`;
      }
    };

    cells.forEach((cell) => {
      cell.addEventListener('mouseenter', () => show(cell));
      cell.addEventListener('focus', () => show(cell));
      cell.addEventListener('click', () => show(cell));
    });

    figure.querySelector('.map-cells')?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      const cell = (event.target as HTMLElement).closest<HTMLButtonElement>('.map-cell');
      if (!cell) return;

      const moves: Record<string, readonly [number, number]> = {
        ArrowUp: [-1, 0],
        ArrowDown: [1, 0],
        ArrowLeft: [0, -1],
        ArrowRight: [0, 1],
      };
      const move = moves[key];
      if (!move) return;

      event.preventDefault();
      const row = Math.min(9, Math.max(0, Number(cell.dataset.row) - 1 + move[0]));
      const col = Math.min(9, Math.max(0, Number(cell.dataset.col) - 1 + move[1]));
      const next = cells[row * 10 + col];
      cells.forEach((c) => (c.tabIndex = -1));
      next.tabIndex = 0;
      next.focus();
    });
  }
</script>

<style>
  .map-card {
    margin: 0;
    padding: 14px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 22px;
    box-shadow: var(--shadow);
  }

  .map-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 4px 6px 13px;
  }

  .map-title {
    margin: 0;
    font: 700 15px/1.2 var(--sans);
    letter-spacing: -0.01em;
  }

  .map-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font: 600 12.5px/1.2 var(--sans);
    color: var(--pink);
    text-decoration: none;
    white-space: nowrap;
  }

  .map-link:hover {
    text-decoration: underline;
  }

  .map-plot {
    display: grid;
    grid-template-columns: 1.35rem minmax(0, 1fr);
    grid-template-rows: 1.15rem auto 1.15rem;
    gap: 4px 6px;
  }

  .col-labels,
  .row-labels {
    font: 600 11.5px/1 var(--sans);
    color: var(--muted);
  }

  .col-labels {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 3px;
    text-align: center;
  }

  .row-labels {
    grid-column: 1;
    grid-row: 2;
    display: grid;
    grid-template-rows: repeat(10, 1fr);
    gap: 3px;
    align-items: center;
    text-align: right;
  }

  .map-cells {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 3px;
    aspect-ratio: 1;
  }

  .map-cell {
    position: relative;
    min-width: 0;
    min-height: 0;
    padding: 0;
    border: 0;
    border-radius: 3px;
    background: var(--cell);
    cursor: crosshair;
    touch-action: manipulation;
  }

  .map-cell:hover,
  .map-cell:focus-visible {
    z-index: 1;
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  .map-cell.best::after {
    content: "";
    position: absolute;
    top: 4px;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--ink);
  }

  .axis.x {
    grid-column: 2;
    grid-row: 3;
    margin: 0;
    text-align: right;
    font: 500 11.5px/1 var(--sans);
    color: var(--muted);
  }

  figcaption {
    display: grid;
    gap: 6px;
    padding: 11px 6px 2px;
  }

  output {
    min-height: 2.9em;
    font: 600 13.5px/1.45 var(--sans);
    color: var(--ink);
  }

  .map-key {
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 480px) {
    .map-card {
      padding: 10px;
    }

    .map-head {
      padding: 2px 2px 10px;
    }

    .map-head,
    figcaption {
      flex-wrap: wrap;
    }

    .map-plot {
      grid-template-columns: 1.15rem minmax(0, 1fr);
      gap: 3px 4px;
    }

    .map-cells,
    .col-labels,
    .row-labels {
      gap: 2px;
    }

    .map-cell.best::after {
      top: 3px;
      width: 4px;
      height: 4px;
      margin-left: -2px;
    }
  }
</style>
